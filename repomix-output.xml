                bgColor: "from-[#0f172a] to-[#1e293b]"
              }
            ];
          }
          setBerandaConfig({ ...berandaConfig, ...data });
        }
      } catch (error) {
        console.error("Gagal mengambil data beranda:", error);
      } finally {
        setLoading(false);
      }
    }
    loadBerandaSettings();
  }, []);

